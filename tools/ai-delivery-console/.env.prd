# 生产环境配置（profile=prd）

# 环境 profile 选择器
AI_DELIVERY_ENV=prd

# 环境标识（前端读取）
VITE_AI_DELIVERY_ENV=prd
# 中心服务地址（生产环境）
VITE_AI_DELIVERY_CENTER_BASE_URL=https://ai-delivery-center.example.com
# Runner 后端地址（本地 Runner）
VITE_AI_DELIVERY_RUNNER_BASE_URL=http://127.0.0.1:8718
# Runner 后端监听端口
VITE_AI_DELIVERY_PORT=8718
# Vite 开发服务器端口
VITE_AI_DELIVERY_DEV_PORT=5178
# Vite 预览服务器端口
VITE_AI_DELIVERY_PREVIEW_PORT=4178
# 允许访问开发服务器的主机名（逗号分隔）
VITE_AI_DELIVERY_ALLOWED_HOSTS=127.0.0.1,localhost
