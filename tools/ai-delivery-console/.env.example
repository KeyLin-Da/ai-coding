# 通过 npm profile 脚本或 AI_DELIVERY_ENV=local|dev|prd 切换环境。
# 禁止在此文件中放置 token、密码、私钥或云端凭据。

# 每个受控 profile 通常只需要声明 Center 代理上游地址。
VITE_AI_DELIVERY_CENTER_BASE_URL=http://127.0.0.1:8728

# 以下配置已有稳定默认值，仅在需要覆盖时取消注释。
# VITE_AI_DELIVERY_RUNNER_BASE_URL=http://127.0.0.1:8718
# VITE_AI_DELIVERY_PORT=8718
# VITE_AI_DELIVERY_DEV_PORT=5178
# VITE_AI_DELIVERY_PREVIEW_PORT=4178
# VITE_AI_DELIVERY_ALLOWED_HOSTS=127.0.0.1,localhost

# 可选：当 Runner 需要使用与仓库根目录不同的工作区根目录时，取消注释。
# AI_DELIVERY_WORKSPACE_ROOT=/Users/you/work/Projects/ai-coding

# 可选：覆盖内置 Agent Provider 命令。
# CODEX_COMMAND=codex exec --sandbox workspace-write -C {workspaceRoot} {projectParentAddDirArgs} {projectAddDirArgs} -
# CODEX_INTERACTIVE_COMMAND=codex --sandbox workspace-write -C {workspaceRoot} {projectParentAddDirArgs} {projectAddDirArgs} --no-alt-screen {prompt}
# CODEBUDDY_COMMAND=codebuddy --add-dir {workspaceRoot} {projectParentAddDirArgs} --allowedTools "Bash,Read,Write" --permission-mode bypassPermissions -p -
# CODEBUDDY_INTERACTIVE_COMMAND=codebuddy --add-dir {workspaceRoot} {projectParentAddDirArgs} --allowedTools "Bash,Read,Write" --permission-mode bypassPermissions {prompt}
# QODER_COMMAND=qcode -w {workspaceRoot} -
# QODER_INTERACTIVE_COMMAND=qcode -w {workspaceRoot} -
# QWEN_COMMAND=qwen -
# QWEN_INTERACTIVE_COMMAND=qwen -
