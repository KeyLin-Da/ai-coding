# 本地开发配置（profile=local）
# 注意：此文件通常包含个人本地地址（如 cloudflare tunnel），不要提交到仓库。

# 环境 profile 选择器
AI_DELIVERY_ENV=local

# 环境标识（前端读取）
VITE_AI_DELIVERY_ENV=local
# 中心服务地址（本地开发）
VITE_AI_DELIVERY_CENTER_BASE_URL=https://dock-poor-mail-herald.trycloudflare.com
# Runner 后端地址（本地 cloudflare tunnel）
VITE_AI_DELIVERY_RUNNER_BASE_URL=http://127.0.0.1:8718
# Runner 后端监听端口
VITE_AI_DELIVERY_PORT=8718
# Vite 开发服务器端口
VITE_AI_DELIVERY_DEV_PORT=5178
# Vite 预览服务器端口
VITE_AI_DELIVERY_PREVIEW_PORT=4178
# 允许访问开发服务器的主机名（逗号分隔，本地用 cloudflare tunnel 域名）
VITE_AI_DELIVERY_ALLOWED_HOSTS=prairie-worldcat-represents-usage.trycloudflare.com
